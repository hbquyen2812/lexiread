# Generate .env with setup.ps1 or python scripts/init_env.py. Never commit .env.
DJANGO_SECRET_KEY=__GENERATE_SECRET__
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=false
TRUST_PROXY_HTTPS=false
POSTGRES_DB=lexiread
POSTGRES_USER=lexiread
POSTGRES_PASSWORD=__GENERATE_DATABASE_PASSWORD__
# Host-mode development; Compose overrides host/port inside web container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30
